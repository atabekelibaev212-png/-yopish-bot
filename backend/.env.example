# Telegram bot token, @BotFather dan oling
BOT_TOKEN=123456789:AA...your_bot_token_here

# Mini App joylashgan public HTTPS manzil (masalan Render/Railway/VPS + domen)
# Bu yerga sizning serveringiz manzili yoziladi, oxirida / bo'lmasin
WEBAPP_URL=https://your-domain.com

# Admin(lar)ning Telegram user ID raqami (bir nechta bo'lsa vergul bilan ajrating)
ADMIN_IDS=123456789

# Server porti
PORT=3000
